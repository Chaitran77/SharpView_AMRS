# DB Setup Commands:
CREATE USER 'sharpview_amrs'@'localhost' IDENTIFIED BY 'k1rt1nku@JAY';
    GRANT ALL PRIVILEGES ON * . * TO 'sharpview_amrs'@'localhost';
    FLUSH PRIVILEGES;
    login with sudo mysql --user=sharpview_amrs --password
    CREATE DATABASE SharpView_AMRS_development_site;
    USE SharpView_AMRS_development_site;

    -- Converters
    CREATE TABLE converters (
        converter_id INT NOT NULL AUTO_INCREMENT,
        ip_address VARCHAR(15) NOT NULL,
        port SMALLINT UNSIGNED NOT NULL DEFAULT 502,
        inverter_station VARCHAR(80) NOT NULL,
        manufacturer TINYTEXT NOT NULL,
        model TINYTEXT NOT NULL,
        record_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        PRIMARY KEY (converter_id),
        INDEX ix_converters__converter_id (converter_id),
        UNIQUE INDEX ix_converters__converter (converter_id)
    );

    -- Sensors
    CREATE TABLE sensors (
        sensor_code VARCHAR(10) NOT NULL,
        converter_id INT NOT NULL,
        modbus_address TINYINT NOT NULL,
        w3w_location TINYTEXT NOT NULL,
        manufacturer TINYTEXT NOT NULL,
        model TINYTEXT NOT NULL,
        colour CHAR(7) NOT NULL DEFAULT '#ffffff',
        record_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        PRIMARY KEY (sensor_code),
        INDEX ix_sensors__sensor_code (sensor_code),
        INDEX ix_sensors__converter_id (converter_id),
        CONSTRAINT fk_sensors__converter_id FOREIGN KEY (converter_id) REFERENCES converters (converter_id) ON DELETE CASCADE
    );

    -- Alarms (Alarm log)
    CREATE TABLE alarms (
        alarm_id INT NOT NULL AUTO_INCREMENT,
        sensor_code VARCHAR(10) NOT NULL ,
        alarm_time DATETIME NOT NULL DEFAULT NOW(),
        responded BOOL NOT NULL DEFAULT FALSE,
        record_timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
        PRIMARY KEY (alarm_id),
        INDEX ix_alarms__alarm_id (alarm_id),
        INDEX ix_alarms__sensor_code (sensor_code),
        CONSTRAINT fk_alarms__sensor_code FOREIGN KEY (sensor_code) REFERENCES sensors (sensor_code) ON DELETE CASCADE
    );

# Full DB backup with
mysqldump --all-databases --single-transaction --quick --lock-tables=false > full-backup-$(date +%F).sql -u root -p

